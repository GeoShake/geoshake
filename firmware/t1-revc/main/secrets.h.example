#pragma once
/* DEPRECATED (N1-T5): this template is no longer needed — devices are not
 * identified by compile-time macros any more.
 *
 * Per-device identity (DEVICE_ID / WiFi SSID-PASS / MQTT user-pass) is now
 * written to NVS by the captive portal (identity.{h,c} -> g_id, captive.c).
 * Every device runs the SAME identity-free binary.
 *
 * Constants that are COMMON to all devices (broker URI, firmware version)
 * live in config.h and ARE committed (they are not secrets). secrets.h is no
 * longer included by main.c.
 *
 * New device: flash -> captive portal on first boot (SoftAP) -> enter WiFi +
 * identity in the form -> written to NVS -> reboot, runs the provisioned branch.
 */
